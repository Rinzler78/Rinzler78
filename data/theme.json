{
  "name": "GitHub Dark + Feu",
  "version": "2.0",

  "palette": {
    "arc_origin": "#f78166",
    "arc_mid": "#c98bd8",
    "bg": "#0d1117",
    "panel": "#161b22",
    "panel_alt": "#1c2128",
    "border": "#30363d",
    "border_muted": "#21262d",
    "text": "#f0f6fc",
    "text_muted": "#8b949e",
    "text_dim": "#6e7681",
    "accent": "#818cf8",
    "accent_dark": "#4f46e5",
    "accent_light": "#a5b4fc",
    "success": "#3fb950",
    "info": "#58a6ff",
    "warn": "#d29922",
    "danger": "#f85149",
    "code_bg": "#0a0d12"
  },

  "palette_light": {
    "arc_origin": "#c2410c",
    "arc_mid": "#8b5cf6",
    "bg": "#ffffff",
    "panel": "#f6f8fa",
    "panel_alt": "#eff2f5",
    "border": "#d0d7de",
    "border_muted": "#e6eaef",
    "text": "#1a1a1f",
    "text_muted": "#6b6256",
    "text_dim": "#9a8f80",
    "accent": "#4f46e5",
    "accent_dark": "#3730a3",
    "accent_light": "#6366f1",
    "success": "#2da44e",
    "info": "#3a6db5",
    "warn": "#bf8700",
    "danger": "#cf222e",
    "code_bg": "#f4eee6"
  },

  "fonts": {
    "display": "Inter",
    "body": "system-ui",
    "mono": "JetBrains Mono",
    "mono_fallback": "ui-monospace, SF Mono, Menlo, Consolas, monospace",
    "display_fallback": "system-ui, -apple-system, sans-serif",
    "body_fallback": "system-ui, -apple-system, sans-serif"
  },

  "patterns": {
    "panel": {
      "corner_radius": 8,
      "border_width": 1,
      "padding_x": 24,
      "padding_y": 20,
      "header_height": 32,
      "label_font_size": 11,
      "label_letter_spacing": "0.08em",
      "label_color": "text_muted",
      "label_weight": 600
    },

    "stat_card": {
      "value_font_size": 28,
      "value_weight": 700,
      "value_color": "text",
      "label_font_size": 10,
      "label_color": "text_muted",
      "label_letter_spacing": "0.1em"
    },

    "bar": {
      "height": 8,
      "corner_radius": 2,
      "track_color": "border_muted",
      "fill_color": "accent",
      "label_color": "text",
      "value_color": "text_muted",
      "label_font_size": 12
    },

    "chip": {
      "corner_radius": 999,
      "padding_x": 12,
      "padding_y": 6,
      "border_color": "border",
      "bg_color": "panel_alt",
      "text_color": "text",
      "accent_text_color": "accent",
      "font_size": 11,
      "font_weight": 500
    },

    "status_dot": {
      "radius": 4,
      "color": "success",
      "pulse_duration": "1.8s"
    },

    "arc": {
      "stops": ["arc_origin", "arc_mid", "accent", "accent_dark"]
    },

    "level_colors": {
      "expert": "accent",
      "expert-legacy": "accent_dark",
      "intermediate": "info",
      "operational": "warn",
      "notions": "text_dim"
    }
  },

  "//series": "Categorical colors for data series, validated for color-vision deficiency. Deliberately NOT the brand accent: an indigo/coral-led set measures deltaE 1.5 between coral and aqua under protanopia. Indigo and coral stay as interface accents.",
  "series": {
    "embedded": "#d95926",
    "mobile": "#d55181",
    "backend": "#3987e5",
    "devops": "#199e70",
    "blockchain": "#c98500",
    "ai-llm": "#9085e9"
  },

  "series_light": {
    "embedded": "#eb6834",
    "mobile": "#e87ba4",
    "backend": "#2a78d6",
    "devops": "#1baf7a",
    "blockchain": "#eda100",
    "ai-llm": "#4a3aa7"
  }
}
