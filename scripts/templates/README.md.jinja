{#- Front page v2 (ADR-015, ADR-016, ADR-018). Every figure comes from the
    `front` view (scripts/front.py); tiles are 415 px half tiles on one grid,
    dark by default with a light override; all text is native markdown. -#}
{%- set svg = svg | default('') -%}
{%- set lang = lang | default('fr') -%}
{%- set f = front -%}
{%- macro half(name, alt) -%}
<picture><source media="(prefers-color-scheme: light)" srcset="assets/svg/{{ svg }}light/{{ name }}" /><img src="assets/svg/{{ svg }}{{ name }}" width="415" alt="{{ alt }}" /></picture>
{%- endmacro -%}
<div align="right">
<sub>{% if lang == 'en' %}<a href="README.md">🇫🇷 Français</a> · <b>🇬🇧 English</b>{% else %}<b>🇫🇷 Français</b> · <a href="README.en.md">🇬🇧 English</a>{% endif %}</sub>
</div>

{{ half('identity.svg', f.identity.aria) }} {{ half('figures.svg', f.figures.aria) }}

