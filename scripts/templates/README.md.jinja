{%- set svg = svg | default('') -%}
{%- set lang = lang | default('fr') -%}
<div align="right">
<sub>{% if lang == 'en' %}<a href="README.md">🇫🇷 Français</a> · <b>🇬🇧 English</b>{% else %}<b>🇫🇷 Français</b> · <a href="README.en.md">🇬🇧 English</a>{% endif %}</sub>
</div>

<div align="center">

<a href="mailto:{{ profile.contacts.email_pro }}">
  <picture>
    <source media="(prefers-color-scheme: light)" srcset="assets/svg/{{ svg }}light/header.svg" />
    <img src="assets/svg/{{ svg }}header.svg" width="100%" alt="Header — {{ profile.name }}, {{ profile.role }}. Statut : {{ profile.status }}. Basé à {{ profile.location.city }}, {{ profile.location.country }}. Langues : {{ profile.languages | join(' / ') }}. {{ 2026 - profile.since_coding }} années de code." />
  </picture>
</a>

{% set typing_lines = profile.taglines | join(';') | replace(' ', '+') %}
<picture>
  <source media="(prefers-color-scheme: light)" srcset="https://readme-typing-svg.demolab.com/?font=JetBrains+Mono&weight=600&size=20&pause=1200&center=true&vCenter=true&width=600&height=45&color={{ theme.palette_light.accent | replace('#', '') }}&lines={{ typing_lines }}" />
  <img src="https://readme-typing-svg.demolab.com/?font=JetBrains+Mono&weight=600&size=20&pause=1200&center=true&vCenter=true&width=600&height=45&color={{ theme.palette.accent | replace('#', '') }}&lines={{ typing_lines }}" alt="{{ profile.taglines | join(' · ') }}" />
</picture>

</div>

<p align="center">

{{ content.approach.paragraph }}

</p>

<div align="center">

<picture>
  <source media="(prefers-color-scheme: light)" srcset="assets/svg/{{ svg }}light/services.svg" />
  <img src="assets/svg/{{ svg }}services.svg" width="100%" alt="Services : {% for s in services | selectattr('visible') | sort(attribute='priority') %}{{ s.title }}{% if not loop.last %} · {% endif %}{% endfor %}." />
</picture>

</div>

<div align="center">

<picture>
  <source media="(prefers-color-scheme: light)" srcset="assets/svg/{{ svg }}light/core-expertise.svg" />
  <img src="assets/svg/{{ svg }}core-expertise.svg" width="100%" alt="Core expertise — niveau actuel et pic atteint pour les compétences signature : {% for s in techs | selectattr('featured') %}{{ s.label }} ({{ s.level_current }}){% if not loop.last %}, {% endif %}{% endfor %}." />
</picture>

</div>

<div align="center">

<a href="https://github.com/{{ profile.username }}?tab=repositories">
  <picture>
    <source media="(prefers-color-scheme: light)" srcset="assets/svg/{{ svg }}light/featured-projects.svg" />
    <img src="assets/svg/{{ svg }}featured-projects.svg" width="100%" alt="Featured projects — {{ projects_highlighted() | length }} dépôts publics phares avec stack et description." />
  </picture>
</a>

</div>

<table align="center">
  <tr>
    <td valign="top" width="52%">
      <picture>
        <source media="(prefers-color-scheme: light)" srcset="assets/svg/{{ svg }}light/stack-summary.svg" />
        <img src="assets/svg/{{ svg }}stack-summary.svg" width="100%" alt="Stack summary — ancienneté par domaine : {% for d in domains | sort(attribute='order') %}{{ d.label }}{% if not loop.last %}, {% endif %}{% endfor %}." />
      </picture>
    </td>
    <td valign="top" width="26%">
      <picture>
        <source media="(prefers-color-scheme: light)" srcset="assets/svg/{{ svg }}light/activity-stats.svg" />
        <img src="assets/svg/{{ svg }}activity-stats.svg" width="100%" alt="Activity stats — années de code, technologies, dépôts publics, projets actifs." />
      </picture>
    </td>
    <td valign="top" width="22%">
      <picture>
        <source media="(prefers-color-scheme: light)" srcset="assets/svg/{{ svg }}light/timeline-mini.svg" />
        <img src="assets/svg/{{ svg }}timeline-mini.svg" width="100%" alt="Timeline mini — jalons de carrière de {{ (timeline | first).year }} à {{ (timeline | last).year }}." />
      </picture>
    </td>
  </tr>
</table>

<div align="center">

<picture>
  <source media="(prefers-color-scheme: light)" srcset="assets/svg/{{ svg }}light/methodology.svg" />
  <img src="assets/svg/{{ svg }}methodology.svg" width="100%" alt="How I work — principes d'ingénierie : {% for m in methodology | sort(attribute='order') %}{{ m.title }}{% if not loop.last %} · {% endif %}{% endfor %}." />
</picture>

</div>

<div align="center">

<sub><b>{% if lang == 'en' %}Live GitHub activity{% else %}Activité GitHub en direct{% endif %}</b></sub>

<picture>
  <source media="(prefers-color-scheme: light)" srcset="https://github-readme-stats.vercel.app/api?username={{ profile.username }}&show_icons=true&hide_rank=true&hide_border=true&bg_color={{ theme.palette_light.panel | replace('#', '') }}&title_color={{ theme.palette_light.accent | replace('#', '') }}&text_color={{ theme.palette_light.text | replace('#', '') }}&icon_color={{ theme.palette_light.accent | replace('#', '') }}" />
  <img src="https://github-readme-stats.vercel.app/api?username={{ profile.username }}&show_icons=true&hide_rank=true&hide_border=true&bg_color={{ theme.palette.panel | replace('#', '') }}&title_color={{ theme.palette.accent | replace('#', '') }}&text_color={{ theme.palette.text | replace('#', '') }}&icon_color={{ theme.palette.accent | replace('#', '') }}" width="60%" alt="GitHub stats for {{ profile.username }} (rank hidden — no inflated grade)." />
</picture>

<picture>
  <source media="(prefers-color-scheme: light)" srcset="https://github-readme-activity-graph.vercel.app/graph?username={{ profile.username }}&hide_border=true&area=true&bg_color={{ theme.palette_light.panel | replace('#', '') }}&color={{ theme.palette_light.text | replace('#', '') }}&line={{ theme.palette_light.accent | replace('#', '') }}&point={{ theme.palette_light.accent | replace('#', '') }}&title_color={{ theme.palette_light.accent | replace('#', '') }}" />
  <img src="https://github-readme-activity-graph.vercel.app/graph?username={{ profile.username }}&hide_border=true&area=true&bg_color={{ theme.palette.panel | replace('#', '') }}&color={{ theme.palette.text | replace('#', '') }}&line={{ theme.palette.accent | replace('#', '') }}&point={{ theme.palette.accent | replace('#', '') }}&title_color={{ theme.palette.accent | replace('#', '') }}" width="100%" alt="Contribution activity graph for {{ profile.username }}." />
</picture>

<picture>
  <source media="(prefers-color-scheme: light)" srcset="https://raw.githubusercontent.com/{{ profile.username }}/{{ profile.username }}/output/github-contribution-grid-snake.svg" />
  <img src="https://raw.githubusercontent.com/{{ profile.username }}/{{ profile.username }}/output/github-contribution-grid-snake-dark.svg" width="100%" alt="Contribution snake eating the activity grid for {{ profile.username }}." />
</picture>

</div>

