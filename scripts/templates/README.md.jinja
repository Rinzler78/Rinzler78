<div align="center">

<picture>
  <source media="(prefers-color-scheme: light)" srcset="assets/svg/{{ svg }}light/modes.svg" />
  <img src="assets/svg/{{ svg }}modes.svg" width="100%" alt="Modes d'intervention : {% for m in modes | sort(attribute='order') %}{{ m.label }}{% if not loop.last %} · {% endif %}{% endfor %}." />
</picture>

</div>

<div align="center">

<picture>
  <source media="(prefers-color-scheme: light)" srcset="assets/svg/{{ svg }}light/map.svg" />
  <img src="assets/svg/{{ svg }}map.svg" width="100%" alt="Localisation — {{ profile.location.city }}, {{ profile.location.region }}, {{ profile.location.country }}. Coordonnées {{ profile.location.lat }}° N, {{ profile.location.lon }}° E." />
</picture>

</div>

