{%- import '_pieces.md.jinja' as pc -%}
{%- set svg = svg | default('') -%}
{%- set root = root | default('../') -%}
{%- set lang = lang | default('fr') -%}
{{ pc.back(root, lang) }}

# {% if lang == 'en' %}Technical stack{% else %}Stack technique{% endif %}

<div align="center">
{{ pc.fig(root, svg, 'core-expertise.svg', 'Core expertise — measured hours and level') }}
</div>

<table align="center">
  <tr>
    <td valign="top" width="70%">
      {{ pc.fig(root, svg, 'stack-summary.svg', 'Seniority per domain') }}
    </td>
    <td valign="top" width="30%">
      {{ pc.fig(root, svg, 'activity-stats.svg', 'Activity stats') }}
    </td>
  </tr>
</table>

{% macro chart(name, block) -%}
<picture>
  <source media="(prefers-color-scheme: light)" srcset="{{ root }}assets/svg/{{ svg }}light/{{ name }}.svg" />
  <img src="{{ root }}assets/svg/{{ svg }}{{ name }}.svg" width="100%" alt="{{ block.aria }}" />
</picture>

{{ block.conclusion }}
{%- endmacro %}
## {{ content.charts.journey_share.title }}

{{ chart('journey-share', content.charts.journey_share) }}

## {{ content.charts.top_skills.title }}

{{ chart('top-skills', content.charts.top_skills) }}

## {{ content.charts.domain_split.title }}

{{ chart('domain-split', content.charts.domain_split) }}

## {% if lang == 'en' %}All skills, by domain{% else %}Toutes les compétences, par domaine{% endif %}

{% for d in domains | sort(attribute='order') %}
{%- set ds = techs_by_domain(d.id) %}
{% if ds %}
**{{ d.label }}**

| {% if lang == 'en' %}Skill | Hours | Level | Active | Versions{% else %}Compétence | Heures | Niveau | Période | Versions{% endif %} |
|---|---|---|---|---|
{% for t in ds %}| {{ t.label }} | {{ t.display_hours }} | {{ t.level }} | {{ t.since }}–{{ t.until or 'now' }} | {{ t.display_version | default('—') }} |
{% endfor %}

{% endif %}
{% endfor %}

<details>
<summary><code>$ cat Boris.cs  # profile as code</code></summary>

```csharp
{{ profile_as_code | replace('&amp;', '&') }}
```

</details>

{{ pc.back(root, lang) }}
