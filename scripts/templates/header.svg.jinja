{%- import '_panel.svg.jinja' as p -%}
{#- Hero banner — light-first. Name + arc set in Fraunces, outlined to paths
    (ADR-007); the arc ribbon gradient encodes embedded(warm) -> ai(cool). -#}
{%- set pal = theme.palette -%}
{%- set stops = theme.patterns.arc.stops -%}
{%- set width = 1200 -%}
{%- set height = 300 -%}
{%- set arc_x0 = 140 -%}
{%- set arc_x1 = 1060 -%}
{%- set n_arc = signature_arc | length -%}
{%- set step = (arc_x1 - arc_x0) / (n_arc - 1) -%}
{%- set name = outline(profile.name, 66) -%}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{ width }} {{ height }}" width="{{ width }}" height="{{ height }}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="{{ profile.name }} — {{ profile.role }}. {{ profile.hero_subtitle }}. Arc : {% for n in signature_arc %}{{ n.label }} {{ n.year }}{{ ', ' if not loop.last else '' }}{% endfor %}. {{ profile.hero_scale }}.">
  <title>{{ profile.name }} — hero</title>
  <desc>Bandeau d'identité : nom, rôle, arc de carrière embedded → mobile → cloud → ai, et échelle d'expérience.</desc>

  <defs>
    <linearGradient id="arc-h" x1="0" y1="0" x2="1" y2="0">
      {% for key in stops %}
      <stop offset="{{ (loop.index0 / (n_arc - 1)) | round(3) }}" stop-color="{{ pal[key] }}"/>
      {% endfor %}
    </linearGradient>
    <linearGradient id="arc-v" x1="0" y1="0" x2="0" y2="1">
      {% for key in stops %}
      <stop offset="{{ (loop.index0 / (n_arc - 1)) | round(3) }}" stop-color="{{ pal[key] }}"/>
      {% endfor %}
    </linearGradient>
  </defs>

  <rect width="{{ width }}" height="{{ height }}" fill="{{ pal.bg }}"/>
  <rect x="1" y="1" width="{{ width - 2 }}" height="{{ height - 2 }}" rx="14" fill="{{ pal.panel }}" stroke="{{ pal.border }}" stroke-width="1"/>
  <rect x="0" y="0" width="6" height="{{ height }}" rx="3" fill="url(#arc-v)"/>

  {#- status row, top-right -#}
  <g transform="translate(872 38)">
    {{ p.status_dot(8, 8, 'success') }}
    <text x="22" y="12" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="12" fill="{{ pal.success }}" font-weight="600">{{ profile.status }}</text>
    <text x="{{ 22 + (profile.status | length) * 7 + 8 }}" y="12" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="12" fill="{{ pal.text_muted }}">· {{ profile.location.city }}, {{ profile.location.country }} · {{ profile.languages | join(' / ') }}</text>
  </g>

  {#- name — Fraunces, outlined to a path (ADR-007) -#}
  <g transform="translate(56 96)" fill="{{ pal.text }}"><path d="{{ name.path }}"/></g>

  {#- role + who-for subtitle -#}
  <text x="58" y="132" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="15" font-weight="600" fill="{{ pal.accent }}">{{ profile.role }}</text>
  <text x="58" y="156" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="13" fill="{{ pal.text_muted }}">— {{ profile.hero_subtitle }}</text>

  {#- signature arc ribbon -#}
  <line x1="{{ arc_x0 }}" y1="216" x2="{{ arc_x1 }}" y2="216" stroke="url(#arc-h)" stroke-width="2.5" stroke-linecap="round"/>
  {% for n in signature_arc %}
  {%- set nx = (arc_x0 + loop.index0 * step) | round(1) -%}
  {%- set col = pal[stops[loop.index0]] -%}
  {%- set lab = outline(n.label, 17) -%}
  <g>
    <circle cx="{{ nx }}" cy="216" r="13" fill="{{ col }}" opacity="0.16">
      <animate attributeName="opacity" values="0.16;0.34;0.16" dur="3s" begin="{{ loop.index0 * 0.45 }}s" repeatCount="indefinite"/>
    </circle>
    <circle cx="{{ nx }}" cy="216" r="6.5" fill="{{ col }}"/>
    <g transform="translate({{ (nx - lab.width / 2) | round(1) }} 198)" fill="{{ col }}"><path d="{{ lab.path }}"/></g>
    <text x="{{ nx }}" y="242" text-anchor="middle" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="14" font-weight="700" fill="{{ pal.text }}">{{ n.year }}</text>
    <text x="{{ nx }}" y="260" text-anchor="middle" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="10.5" fill="{{ pal.text_muted }}">{{ n.signature | xml }}</text>
  </g>
  {% endfor %}

  {#- experience scale -#}
  <text x="58" y="288" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="11" font-style="italic" fill="{{ pal.text_dim }}">// {{ profile.hero_scale }}</text>
</svg>
