{#- Shared markdown pieces. `root` is the path prefix back to the repo root
    ('' from README, '../' from pages/, '../../' from pages/en/); `svg` is the
    language SVG prefix ('' for FR, 'en/' for EN). -#}

{%- macro fig(root, svg, name, alt, width='100%') -%}
<picture>
  <source media="(prefers-color-scheme: dark)" srcset="{{ root }}assets/svg/{{ svg }}dark/{{ name }}" />
  <img src="{{ root }}assets/svg/{{ svg }}{{ name }}" width="{{ width }}" alt="{{ alt }}" />
</picture>
{%- endmacro -%}

{%- macro back(root, lang) -%}
<sub><a href="{{ root }}README{{ '.en' if lang == 'en' else '' }}.md">{{ '← Back to profile' if lang == 'en' else '← Retour au profil' }}</a></sub>
{%- endmacro -%}
