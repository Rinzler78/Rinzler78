{%- import '_panel.svg.jinja' as p -%}
{%- set width = 1200 -%}
{%- set height = 320 -%}
{%- set pal = theme.palette -%}
{%- set loc = profile.location -%}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{ width }} {{ height }}" width="{{ width }}" height="{{ height }}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Localisation — basé à {{ loc.city }}, {{ loc.region }}, {{ loc.country }}. Coordonnées {{ loc.lat }} N, {{ loc.lon }} E.">
  <title>Location — {{ loc.city }}</title>
  <desc>Carte de France stylisée avec marqueur pulsant sur {{ loc.city }}.</desc>

  <rect width="{{ width }}" height="{{ height }}" fill="{{ pal.bg }}"/>
  {{ p.panel(0, 0, width, height, 'LOCATION') }}

  <!-- Coords sticker à droite -->
  <g transform="translate({{ width - 320 }} 60)">
    <rect x="0" y="0" width="280" height="220" rx="6" fill="{{ pal.panel_alt }}" stroke="{{ pal.border }}" stroke-width="1"/>

    <text x="20" y="32" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="10" letter-spacing="0.1em" fill="{{ pal.text_muted }}">COORDS</text>

    <text x="20" y="62" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="12" fill="{{ pal.text_muted }}">lat</text>
    <text x="80" y="62" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="13" fill="{{ pal.accent }}" font-weight="600">{{ loc.lat }}° N</text>

    <text x="20" y="82" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="12" fill="{{ pal.text_muted }}">lon</text>
    <text x="80" y="82" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="13" fill="{{ pal.accent }}" font-weight="600">{{ loc.lon }}° E</text>

    <line x1="20" y1="100" x2="260" y2="100" stroke="{{ pal.border_muted }}" stroke-width="1"/>

    <text x="20" y="128" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="10" letter-spacing="0.1em" fill="{{ pal.text_muted }}">CITY</text>
    <text x="20" y="148" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="14" fill="{{ pal.text }}" font-weight="700">{{ loc.city }}, {{ loc.postcode }}</text>

    <text x="20" y="170" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="11" fill="{{ pal.text_muted }}">{{ loc.region | truncate(28, true, '…') }}</text>

    <line x1="20" y1="186" x2="260" y2="186" stroke="{{ pal.border_muted }}" stroke-width="1"/>

    <text x="20" y="208" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="10" fill="{{ pal.text_muted }}">tz · {{ loc.tz }}</text>
  </g>

  <!-- Silhouette France -->
  <g transform="translate(160 70)">
    <path d="M 0,60 L 200,30 L 290,80 L 300,140 L 290,180 L 240,200 L 330,300 L 110,320 L 60,300 L 0,220 L 0,150 Z"
          fill="{{ pal.panel_alt }}" stroke="{{ pal.border }}" stroke-width="1.5" stroke-linejoin="round"/>

    <!-- Méditerranée -->
    <path d="M 240,200 L 330,300" stroke="{{ pal.info }}" stroke-width="2" stroke-linecap="round" opacity="0.5"/>

    <!-- Villes de référence -->
    <g fill="{{ pal.text_dim }}">
      <circle cx="170" cy="100" r="2"/><text x="178" y="103" font-family="'{{ theme.fonts.mono }}', monospace" font-size="9" fill="{{ pal.text_muted }}">Paris</text>
      <circle cx="225" cy="195" r="2"/><text x="233" y="198" font-family="'{{ theme.fonts.mono }}', monospace" font-size="9" fill="{{ pal.text_muted }}">Lyon</text>
      <circle cx="240" cy="270" r="2"/><text x="180" y="285" font-family="'{{ theme.fonts.mono }}', monospace" font-size="9" fill="{{ pal.text_muted }}">Marseille</text>
      <circle cx="60" cy="240" r="2"/><text x="68" y="243" font-family="'{{ theme.fonts.mono }}', monospace" font-size="9" fill="{{ pal.text_muted }}">Bordeaux</text>
      <circle cx="5" cy="100" r="2"/><text x="12" y="103" font-family="'{{ theme.fonts.mono }}', monospace" font-size="9" fill="{{ pal.text_muted }}">Brest</text>
    </g>

    <!-- Marqueur Senas -->
    <circle cx="248" cy="258" r="14" fill="none" stroke="{{ pal.accent }}" stroke-width="2" opacity="0">
      <animate attributeName="r" values="6;28;6" dur="2.4s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.7;0;0.7" dur="2.4s" repeatCount="indefinite"/>
    </circle>
    <circle cx="248" cy="258" r="6" fill="{{ pal.accent }}" stroke="{{ pal.bg }}" stroke-width="2"/>
    <text x="262" y="252" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="11" font-weight="700" fill="{{ pal.accent }}">{{ loc.city | upper }}</text>
  </g>

  <!-- Ping easter egg en haut à droite -->
  <text x="{{ width - 24 }}" y="22" text-anchor="end" font-family="'{{ theme.fonts.mono }}', monospace" font-size="10" fill="{{ pal.text_dim }}">{{ content.map.ping_easter_egg }}</text>
</svg>
