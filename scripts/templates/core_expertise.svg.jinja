{%- import '_panel.svg.jinja' as p -%}
{%- set width = 900 -%}
{%- set pal = theme.palette -%}
{#- Featured skills, in skill order (recency, then hours — ADR-018). The bar
    encodes the displayed level on the ADR-013 convention, not the hours: a
    level is a convention, the hours are printed beside it. -#}
{%- set core = skills | selectattr('featured') | list -%}
{%- set row_h = 38 -%}
{%- set header_h = 52 -%}
{%- set height = header_h + core | length * row_h + 16 -%}

{%- set label_w = 180 -%}
{%- set bar_x = 24 + label_w -%}
{%- set value_w = 150 -%}
{%- set bar_w = width - bar_x - value_w - 24 -%}

{%- set level_fill = {'expert': pal.accent, 'advanced': pal.accent, 'professional': pal.info, 'working': pal.info} -%}
{%- set level_rank = {'working': 1, 'professional': 2, 'advanced': 3, 'expert': 4} -%}

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{ width }} {{ height }}" width="{{ width }}" height="{{ height }}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Core expertise — {{ core | length }} signature skills with their measured hours and level: {% for s in core %}{{ s.label }} {{ s.display_hours }} h {{ s.level }}{% if not loop.last %}, {% endif %}{% endfor %}.">
  <title>Core expertise</title>
  <desc>One bar per signature skill: its length is the level on the published convention (working, professional, advanced, expert), the measured hours are printed beside it.</desc>

  <rect width="{{ width }}" height="{{ height }}" fill="{{ pal.bg }}"/>
  {{ p.panel(0, 0, width, height, 'CORE EXPERTISE') }}

  {%- for s in core %}
    {%- set y = header_h + loop.index0 * row_h %}
    {%- set fill = level_fill[s.level] | default(pal.text_dim) %}
    {%- set cur_w = (bar_w * level_rank[s.level] / 4) | round | int %}

    <!-- label -->
    <text x="24" y="{{ y + 12 }}" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="13" font-weight="600" fill="{{ pal.text }}">{{ s.label }}</text>

    <!-- track -->
    <rect x="{{ bar_x }}" y="{{ y + 3 }}" width="{{ bar_w }}" height="12" rx="3" fill="{{ pal.border_muted }}"/>
    <!-- level fill -->
    <rect x="{{ bar_x }}" y="{{ y + 3 }}" width="{{ cur_w }}" height="12" rx="3" fill="{{ fill }}"/>

    <!-- value -->
    <text x="{{ width - 24 }}" y="{{ y + 12 }}" text-anchor="end" font-family="'{{ theme.fonts.mono }}', {{ theme.fonts.mono_fallback }}" font-size="11" fill="{{ pal.text_muted }}">{{ s.display_hours }} h · <tspan fill="{{ fill }}">{{ s.level }}</tspan></text>
  {%- endfor %}
</svg>
