{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile metrics",
  "description": "GitHub account metrics plus per-project external counters (PyPI, Docker Hub, GitHub stars), refreshed daily by the update-profile workflow. Counters are fetched, never hard-coded; every fetched_at is the date its values were fetched, distinct from the activity date. Single object (not a collection).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "username",
    "public_repos",
    "total_stars",
    "last_push",
    "fetched_at",
    "external",
    "errors"
  ],
  "properties": {
    "username": { "type": "string", "minLength": 1 },
    "public_repos": { "type": "integer", "minimum": 0 },
    "total_stars": { "type": "integer", "minimum": 0 },
    "last_push": { "type": "string", "format": "date" },
    "fetched_at": { "type": "string", "format": "date" },
    "external": {
      "description": "Keyed by project id (data/projects.json). fetched_at is the date of the oldest value in the entry: a failing source keeps its previous value and date.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9._-]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fetched_at"],
        "minProperties": 2,
        "properties": {
          "pypi_downloads_last_month": { "type": "integer", "minimum": 0 },
          "pypi_releases": { "type": "integer", "minimum": 0 },
          "docker_pulls": { "type": "integer", "minimum": 0 },
          "stars": { "type": "integer", "minimum": 0 },
          "fetched_at": { "type": "string", "format": "date" }
        }
      }
    },
    "errors": {
      "description": "Sources that failed during the last run; their counters kept the previous values.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project", "source", "message"],
        "properties": {
          "project": { "type": "string", "minLength": 1 },
          "source": { "enum": ["github", "pypi", "dockerhub"] },
          "message": { "type": "string" }
        }
      }
    }
  }
}
