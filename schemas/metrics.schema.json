{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub metrics",
  "description": "Aggregated GitHub account metrics refreshed by the weekly update-profile workflow. Single object (not a collection).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "username",
    "public_repos",
    "total_stars",
    "last_push",
    "fetched_at"
  ],
  "properties": {
    "username": { "type": "string", "minLength": 1 },
    "public_repos": { "type": "integer", "minimum": 0 },
    "total_stars": { "type": "integer", "minimum": 0 },
    "last_push": { "type": "string", "format": "date" },
    "fetched_at": { "type": "string", "format": "date" }
  }
}
