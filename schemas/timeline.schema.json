{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Timeline collection",
  "description": "Narrative milestones layer (storytelling frieze). Editorial highlights of the journey, distinct from experiences.json (the dated hours-source). techs_added references existing tech ids or version ids; it is metadata, not rendered.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["year", "label", "description", "techs_added", "highlight"],
    "properties": {
      "year": { "type": "string", "minLength": 1 },
      "label": { "type": "string", "minLength": 1 },
      "description": { "type": "string" },
      "techs_added": { "type": "array", "items": { "type": "string" } },
      "techs_summary": { "type": ["string", "null"] },
      "highlight": { "type": "boolean" },
      "is_now": { "type": "boolean" },
      "is_milestone": { "type": "boolean" },
      "is_origin": { "type": "boolean" }
    }
  }
}
