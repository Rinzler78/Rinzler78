{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mode collection",
  "description": "Engagement modes (how to hire: one-shot fire-fighting, long-term support, audit, technical co-founder). Distinct from Service (what is bought).",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "label", "description", "order"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "label": { "type": "string", "minLength": 1 },
      "description": { "type": "string", "minLength": 1 },
      "order": { "type": "integer", "minimum": 1 }
    }
  }
}
