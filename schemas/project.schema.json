{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project collection",
  "description": "Public repos shown on the profile: display fields (highlight, description, stack_label) and the sources of their external counters (metrics). Hours never come from here: they are measured from commit evidence (ADR-013).",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "github_url", "domain", "tech_ids"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
      "name": { "type": "string", "minLength": 1 },
      "github_url": { "type": "string", "pattern": "^https://github\\.com/" },
      "domain": { "type": "string", "minLength": 1 },
      "tech_ids": { "type": "array", "items": { "type": "string" } },
      "start": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
      "end": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}$" },
      "state": { "enum": ["active", "legacy", "archive"] },
      "highlight": { "type": "boolean" },
      "description": { "type": "string" },
      "stack_label": { "type": "string" },
      "category": { "type": "string" },
      "pypi": { "type": "string" },
      "metrics": {
        "description": "Sources of external counters (package and image ids). Counters are read live, never stored (ADR-016 as amended).",
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "pypi": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "dockerhub": { "type": "string", "pattern": "^[a-z0-9._-]+/[a-z0-9._-]+$" }
        }
      }
    }
  }
}
