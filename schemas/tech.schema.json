{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tech collection",
  "description": "Technical skills catalogue: labels, domains and versions. Hours, levels and periods are never stored here: the generator reads them from data/activity/aggregates.json (ADR-013, ADR-018). since lives only inside versions[].",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "label", "domain", "versions"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
      "label": { "type": "string", "minLength": 1 },
      "domain": { "type": "string", "minLength": 1 },
      "display_version": { "type": "string" },
      "notes": { "type": "string" },
      "featured": { "type": "boolean" },
      "versions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "since"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
            "version": { "type": "string", "minLength": 1 },
            "since": { "type": ["integer", "null"] }
          }
        }
      }
    }
  }
}
